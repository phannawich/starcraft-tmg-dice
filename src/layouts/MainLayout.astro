---
type StructuredData = Record<string, unknown> | Array<Record<string, unknown>>;

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noIndex?: boolean;
  structuredData?: StructuredData;
}

const {
  title = "StarCraft TMG Dice Calculator",
  description = "Calculate StarCraft TMG attack outcomes with exact probabilities. See hit, bypass, armour, evade, and total damage distributions with interactive charts.",
  canonicalUrl,
  canonicalPath,
  ogImage,
  ogImageAlt = "StarCraft TMG Dice Calculator preview card",
  noIndex = false,
  structuredData,
} = Astro.props;

const pathname = canonicalPath ?? Astro.url.pathname;
const resolvedCanonicalUrl = canonicalUrl ?? (Astro.site ? new URL(pathname, Astro.site).toString() : Astro.url.toString());
const resolvedOgImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).toString() : null;
const twitterCardType = resolvedOgImageUrl ? "summary_large_image" : "summary";
const robotsContent = noIndex ? "noindex, nofollow" : "index, follow";
const structuredDataJson = structuredData ? JSON.stringify(structuredData) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0c1015" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={resolvedCanonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:site_name" content="StarCraft TMG Dice Calculator" />
    {resolvedOgImageUrl && <meta property="og:image" content={resolvedOgImageUrl} />}
    {resolvedOgImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={twitterCardType} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImageUrl && <meta name="twitter:image" content={resolvedOgImageUrl} />}
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PZQM0SN7RK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-PZQM0SN7RK");
    </script>
    <style is:global>
      :root {
        --bg-app: #0f1218;
        --bg-elev-1: #151a22;
        --bg-elev-2: #1b2230;
        --bg-input: #101620;
        --bg-input-disabled: #0d121a;
        --text-primary: #e7ecf5;
        --text-secondary: #a6b2c7;
        --text-disabled: #7f8da4;
        --accent: #5bb4ff;
        --accent-2: #39c49a;
        --line: #2b3648;
        --line-disabled: #4a5972;
        --danger: #ff6b6b;
        --focus: #7fc4ff;
        --shadow-1: rgba(2, 8, 20, 0.52);

        --bg-0: var(--bg-app);
        --bg-1: #121722;
        --ink: var(--text-primary);
        --ink-soft: var(--text-secondary);
        --surface: var(--bg-elev-1);
        --app-backdrop:
          radial-gradient(1050px 620px at 100% -10%, rgba(91, 180, 255, 0.15), transparent 56%),
          radial-gradient(860px 640px at -12% 112%, rgba(57, 196, 154, 0.13), transparent 52%),
          linear-gradient(180deg, var(--bg-1) 0%, var(--bg-0) 58%, #0c1015 100%);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background-color: #0c1015;
      }

      html {
        background: var(--app-backdrop);
      }

      body {
        position: relative;
        isolation: isolate;
        font-family: "Space Grotesk", "Avenir Next", "Segoe UI", sans-serif;
        color: var(--ink);
        background: transparent;
        min-height: 100vh;
        min-height: 100dvh;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: var(--app-backdrop);
      }

      main {
        width: min(1120px, 100% - 2rem);
        margin: 0 auto;
        padding: clamp(1.25rem, 1.6vw, 2rem) 0 2.5rem;
      }

      .panel {
        background: linear-gradient(
          180deg,
          color-mix(in srgb, var(--surface) 92%, #1f2a3a 8%) 0%,
          color-mix(in srgb, var(--surface) 94%, #141b25 6%) 100%
        );
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: 0 14px 28px -22px var(--shadow-1);
      }

      .seo-details {
        margin-top: 1.05rem;
        padding: 0.9rem 1rem;
      }

      .seo-details > summary {
        cursor: pointer;
        list-style: none;
        font-weight: 600;
        color: var(--ink);
      }

      .seo-details > summary::-webkit-details-marker {
        display: none;
      }

      .seo-details > summary::after {
        content: " +";
        color: var(--ink-soft);
      }

      .seo-details[open] > summary::after {
        content: " -";
      }

      .seo-details-content {
        margin-top: 0.75rem;
        display: grid;
        gap: 0.72rem;
        color: var(--ink-soft);
      }

      .seo-details-content h2 {
        margin: 0;
        color: var(--ink);
        font-size: 1rem;
      }

      .seo-details-content p,
      .seo-details-content ul,
      .seo-details-content ol,
      .seo-details-content pre {
        margin: 0;
      }

      .mono {
        font-family: "IBM Plex Mono", "SFMono-Regular", "Consolas", monospace;
      }

      .surge-formula-input::placeholder {
        color: color-mix(in srgb, var(--ink-soft) 86%, #0e141d 14%);
        opacity: 1;
      }

      .field-input::placeholder {
        color: color-mix(in srgb, var(--ink-soft) 86%, #0e141d 14%);
        opacity: 1;
      }

      input[type="checkbox"] {
        accent-color: var(--accent);
      }

      a {
        color: var(--accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
      }

      a:hover {
        color: color-mix(in srgb, var(--accent) 80%, #ffffff 20%);
      }

      :focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 2px;
      }

      .attack-primary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.75rem;
      }

      .defend-primary-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
      }

      @media (max-width: 1120px) {
        .attack-primary-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 720px) {
        .attack-primary-grid,
        .defend-primary-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      @media (max-width: 720px) {
        main {
          width: min(1120px, 100% - 1rem);
        }
      }

      .site-footer {
        margin-top: clamp(1.5rem, 2.6vw, 2.5rem);
        padding-top: 1rem;
        border-top: 1px solid color-mix(in srgb, var(--line) 88%, #06090d 12%);
        color: color-mix(in srgb, var(--ink-soft) 94%, #0a0f16 6%);
        font-size: 0.75rem;
        line-height: 1.2;
      }

      .site-footer p {
        margin: 0;
      }

      .site-footer .kofi-row {
        display: flex;
        justify-content: flex-end;
      }

      .kofi-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem 0.7rem;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--accent) 62%, #0b1119 38%);
        background: color-mix(in srgb, var(--accent) 16%, #0f1520 84%);
        color: color-mix(in srgb, var(--ink) 94%, #ffffff 6%);
        font-weight: 600;
        font-size: 0.8rem;
        text-decoration: none;
        box-shadow: 0 10px 22px -14px rgba(2, 8, 16, 0.9);
      }

      .kofi-link:hover {
        background: color-mix(in srgb, var(--accent) 24%, #101824 76%);
        color: #ffffff;
      }

      @media (max-width: 720px) {
        .kofi-link {
          padding: 0.35rem 0.6rem;
          font-size: 0.76rem;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
      <footer class="site-footer">
        <p>StarCraft and related names, logos, and trademarks belong to their respective owners. This project is not affiliated with, endorsed by, or sponsored by Blizzard Entertainment or Archon Studio. </p>
        <p>This tool was created by Phannawich (Boss) Jadpotwanich</p>
        <p>Bug reports are welcome on <a href="https://github.com/phannawich/starcraft-tmg-dice">GitHub.</a></p>
        <p class="kofi-row"><a class="kofi-link" href="https://ko-fi.com/X8X51Y3TPS" target="_blank" rel="noopener noreferrer">Support this project on Ko-fi</a></p>
      </footer>
    </main>
  </body>
</html>
